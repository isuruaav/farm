{
  "name": "forest-lanka-php",
  "version": "1.0.0",
  "private": true,
  "description": "Local Tailwind CSS v4 assets for the FOREST LANKA PHP website",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build-assets.mjs",
    "build:css": "tailwindcss -i assets/css/tailwind-input.css -o assets/css/utilities.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind-input.css -o assets/css/utilities.css --watch",
    "test:styles": "node tests/styles.test.mjs",
    "test:cart": "node tests/cart.test.cjs",
    "test:experience": "node tests/experience.test.cjs",
    "test:integration": "python tests/verify.py"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "@tailwindcss/cli": "4.3.5",
    "lightningcss": "1.33.0",
    "tailwindcss": "4.3.5"
  }
}
